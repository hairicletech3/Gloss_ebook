# Copy this file to .env.local and fill it in.
# .env.local is gitignored. Both Vite and Prisma read it.

# ── Browser (Vite) ───────────────────────────────────────────────────
# Only VITE_-prefixed vars are compiled into the browser bundle. These two
# are safe there: the anon key is public by design and RLS is what actually
# protects your data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Prisma (schema + migrations, local machine only) ─────────────────
# NOT prefixed VITE_, so it never reaches the browser. This URL contains your
# database password and connects as the database owner, bypassing RLS.
#
# Migrations need the SESSION-mode pooler on port 5432. The transaction-mode
# pooler (6543) cannot hold the advisory locks Prisma Migrate requires.
# Supabase dashboard → Connect → ORMs.
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres"

# Optional. The app does not use Prisma at runtime, so this is only needed if
# you add your own Node scripts that query through the transaction pooler.
# DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ── Edge Function secrets — NOT in this file ─────────────────────────
# Set these with the CLI so they never enter the repo or the bundle:
#
#   supabase secrets set AZURE_TRANSLATOR_KEY=...
#   supabase secrets set AZURE_TRANSLATOR_REGION=southeastasia
#
# Optional:
#   TRANSLATE_PROVIDER    azure (default) | anthropic
#   AZURE_TRANSLATOR_ENDPOINT
#   ANTHROPIC_API_KEY     when TRANSLATE_PROVIDER=anthropic
#   ANTHROPIC_MODEL
#   RATE_LIMIT_PER_MIN    default 60 uncached calls per user per minute
#   ALLOWED_ORIGIN        default *; set to your deployed origin
