# ── Browser (Vite) ───────────────────────────────────────────────────
# Copy this file to .env.local and fill it in. Only these two values are
# ever allowed to reach the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Edge Function secrets — NOT in this file, NOT prefixed VITE_ ──────
# Set these with the CLI so they never enter the repo or the bundle:
#
#   supabase secrets set AZURE_TRANSLATOR_KEY=...
#   supabase secrets set AZURE_TRANSLATOR_REGION=southeastasia
#
# Optional:
#   TRANSLATE_PROVIDER    azure (default) | anthropic
#   AZURE_TRANSLATOR_ENDPOINT
#   ANTHROPIC_API_KEY     when TRANSLATE_PROVIDER=anthropic
#   ANTHROPIC_MODEL
#   RATE_LIMIT_PER_MIN    default 60 uncached calls per user per minute
#   ALLOWED_ORIGIN        default *; set to your deployed origin
